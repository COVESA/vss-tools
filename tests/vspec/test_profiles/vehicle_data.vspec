# HIM 'vehicle-data' profile (the default/historic VSS rule set).

Vehicle:
  type: branch
  description: Root branch.

Vehicle.Speed:
  type: sensor
  datatype: float
  unit: km
  description: Vehicle speed.

Vehicle.IsMoving:
  type: attribute
  datatype: boolean
  default: false
  description: Whether the vehicle is moving.

Vehicle.TripMeterReading:
  type: actuator
  datatype: float
  unit: km
  description: Trip meter reading.
