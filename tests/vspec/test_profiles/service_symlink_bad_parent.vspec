# 'symlink' nodes must have an 'iostruct' parent, not 'procedure' directly.

VehicleService:
  type: branch
  description: Root branch of a service tree.

VehicleService.GetPosition:
  type: procedure
  description: Gets the current position.

VehicleService.GetPosition.Version:
  type: attribute
  datatype: string
  default: "0.0.1"
  description: The version of the GetPosition procedure.

VehicleService.GetPosition.BadLink:
  type: symlink
  path: Vehicle.CurrentLocation.Latitude
  domain: Automotive.Vehicle.Car.Data
  version: 3.0.0+
  description: Symlink directly under a procedure (invalid, needs iostruct parent).
