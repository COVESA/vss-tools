# 'sensor' is a 'vehicle-data' profile type, not allowed under 'data'.

Occupant:
  type: branch
  description: Occupant root branch.

Occupant.Speed:
  type: sensor
  datatype: float
  unit: km
  description: Not allowed under the 'data' profile.
