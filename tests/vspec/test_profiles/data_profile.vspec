# HIM 'data' profile (HIM Data Rule Set): 'ro'/'rw' node types.

Occupant:
  type: branch
  description: Occupant root branch.

Occupant.Name:
  type: ro
  datatype: string
  description: The name of a vehicle occupant.

Occupant.LocalTemperature:
  type: rw
  datatype: float
  unit: celsius
  description: The vehicle occupant-local temperature setting.
