# 'iostruct' nodes must be named 'Input' or 'Output'.

VehicleService:
  type: branch
  description: Root branch of a service tree.

VehicleService.GetPosition:
  type: procedure
  description: Gets the current position.

VehicleService.GetPosition.Version:
  type: attribute
  datatype: string
  default: "0.0.1"
  description: The version of the GetPosition procedure.

VehicleService.GetPosition.Result:
  type: iostruct
  description: Badly named iostruct (should be Input/Output).

VehicleService.GetPosition.Result.Latitude:
  type: property
  datatype: float
  description: Latitude output.
