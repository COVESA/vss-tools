Types:
  type: branch
  description: Custom struct type definitions used in tests.

Types.Sensor:
  type: struct
  description: A hardware sensor reading with a value and quality indicator.

Types.Sensor.Value:
  type: property
  datatype: double
  description: The measured value reported by the sensor.

Types.Sensor.Quality:
  type: property
  datatype: uint8
  description: Signal quality score from 0 to 100.

Types.AlertRecord:
  type: struct
  description: A diagnostic alert with a severity level and a recorded timestamp.

Types.AlertRecord.Severity:
  type: property
  datatype: string
  allowed: ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
  description: Indicates how serious the alert is.

Types.AlertRecord.OccurredAt:
  type: property
  datatype: uint64
  description: Unix timestamp (ms) when the alert was recorded.

Types.Schedule:
  type: struct
  description: A recurring schedule composed of time windows.

Types.Schedule.Window:
  type: struct
  description: A single time window within a schedule.

Types.Schedule.Window.StartMinute:
  type: property
  datatype: uint16
  description: Start of the window expressed as minutes since midnight.

Types.Schedule.Window.DurationMinutes:
  type: property
  datatype: uint16
  description: Length of the window in minutes.

Types.Schedule.IsEnabled:
  type: property
  datatype: boolean
  description: Indicates whether the schedule is currently active.

Types.Schedule.RepeatCount:
  type: property
  datatype: uint8
  description: How many times the schedule repeats per week (0 means once).

Types.Address:
  type: struct
  description: A postal address. Referenced by other structs via 'datatype'.

Types.Address.Street:
  type: property
  datatype: string
  description: Street name and number.

Types.Address.City:
  type: property
  datatype: string
  description: City name.

Types.Contact:
  type: struct
  description: A contact with a home address and a list of alternate addresses.

Types.Contact.Name:
  type: property
  datatype: string
  description: The contact's full name.

Types.Contact.HomeAddress:
  type: property
  datatype: Types.Address
  description: The contact's primary home address (single struct reference).

Types.Contact.AlternateAddresses:
  type: property
  datatype: Types.Address[]
  description: Additional addresses for the contact (array-of-struct reference).

Types.Device:
  type: struct
  description: A device with a status, a nested location and a backup address (exercises shared enums/records).

Types.Device.Name:
  type: property
  datatype: string
  description: Device name.

Types.Device.Status:
  type: property
  datatype: string
  allowed: ["ONLINE", "OFFLINE"]
  description: Connectivity status.

Types.Device.Location:
  type: struct
  description: Where the device is installed.

Types.Device.Location.Primary:
  type: property
  datatype: Types.Address
  description: Primary installation address (first reference to Address).

Types.Device.Location.Source:
  type: property
  datatype: string
  allowed: ["GPS", "MANUAL"]
  description: How the location was determined (enum inside a nested struct).

Types.Device.BackupAddress:
  type: property
  datatype: Types.Address
  description: Second reference to Address (must be a bare name in AVSC).

Types.Device.KnownAddresses:
  type: property
  datatype: Types.Address[]
  description: Third reference to Address, as an array.
